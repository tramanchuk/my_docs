@startuml
entity "Customer" {
* customer_id : INT
* name : VARCHAR
* email : VARCHAR
* phone : VARCHAR
* address : TEXT
}

entity "Order" {
* order_id : INT
* order_date : DATE
* customer_id : INT
* status : VARCHAR
}

entity "OrderItem" {
* order_item_id : INT
* order_id : INT
* product_id : INT
* quantity : INT
* price : DECIMAL
}

entity "Product" {
* product_id : INT
* name : VARCHAR
* description : TEXT
* price : DECIMAL
* stock_quantity : INT
}

entity "Delivery" {
* delivery_id : INT
* order_id : INT
* delivery_date : DATE
* delivery_status : VARCHAR
}

Customer ||--o{ Order : places
Order ||--o{ OrderItem : contains
OrderItem ||--|| Product : includes
Order ||--o{ Delivery : has
@enduml